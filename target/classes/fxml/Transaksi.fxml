<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="10" xmlns:fx="http://javafx.com/fxml" fx:controller="controller.TransaksiController">
    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
    <GridPane hgap="10" vgap="10">
        <Label text="ID User:"/> <TextField fx:id="txtIdUser" GridPane.columnIndex="1"/>
        <Label text="Nama:" GridPane.rowIndex="1"/> <TextField fx:id="txtNama" editable="false" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
        <Label text="ID Buku:" GridPane.columnIndex="2"/> <TextField fx:id="txtIdBuku" GridPane.columnIndex="3"/>
        <Label text="Judul:" GridPane.rowIndex="1" GridPane.columnIndex="2"/> <TextField fx:id="txtJudul" editable="false" GridPane.columnIndex="3" GridPane.rowIndex="1"/>
        <Label text="Tanggal Transaksi:" GridPane.rowIndex="2"/> <DatePicker fx:id="dpTransaksi" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
    </GridPane>
    <HBox spacing="10">
        <children>
            <Button text="Pinjam Buku" onAction="#handlePinjam"
                    style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold;"/>
            <Button text="Kembalikan Buku" onAction="#handleKembali"
                    style="-fx-background-color: #2980b9; -fx-text-fill: white; -fx-font-weight: bold;"/>
            <Button text="Hapus Log" onAction="#handleHapus"
                    style="-fx-background-color: #c0392b; -fx-text-fill: white; -fx-font-weight: bold;"/>
        </children>
    </HBox>
    <TableView fx:id="tableTransaksi" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colUser" text="User"/>
            <TableColumn fx:id="colNama" text="Nama"/>
            <TableColumn fx:id="colBuku" text="Buku"/>
            <TableColumn fx:id="colJudul" text="Judul"/>
            <TableColumn fx:id="colPinjam" text="Pinjam"/>
            <TableColumn fx:id="colKembali" text="Kembali"/>
            <TableColumn fx:id="colDenda" text="Denda"/>
        </columns>
    </TableView>
</VBox>