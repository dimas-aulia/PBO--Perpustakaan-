<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="15" xmlns:fx="http://javafx.com/fxml" fx:controller="controller.TransaksiController">
    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

    <Label text="Transaksi Perpustakaan" style="-fx-font-size: 18; -fx-font-weight: bold;"/>

    <GridPane hgap="10" vgap="10">
        <Label text="ID User:"/>
        <TextField fx:id="txtIdUser" GridPane.columnIndex="1"/>
        <Label text="Nama:" GridPane.rowIndex="1"/>
        <TextField fx:id="txtNama" editable="false" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

        <Label text="ID Buku:" GridPane.columnIndex="2"/>
        <TextField fx:id="txtIdBuku" GridPane.columnIndex="3"/>
        <Label text="Judul:" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
        <TextField fx:id="txtJudul" editable="false" GridPane.columnIndex="3" GridPane.rowIndex="1"/>
    </GridPane>

    <HBox spacing="10">
        <Button text="Pinjam" onAction="#handlePinjam" style="-fx-background-color: #27ae60; -fx-text-fill: white;"/>
        <Button text="Kembali" onAction="#handleKembali" style="-fx-background-color: #2980b9; -fx-text-fill: white;"/>
        <Button text="Hapus" onAction="#handleHapus" style="-fx-background-color: #c0392b; -fx-text-fill: white;"/>
    </HBox>

    <TableView fx:id="tableTransaksi" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colUser" text="ID User" prefWidth="80"/>
            <TableColumn fx:id="colNama" text="Nama" prefWidth="120"/>
            <TableColumn fx:id="colBuku" text="ID Buku" prefWidth="80"/>
            <TableColumn fx:id="colJudul" text="Judul Buku" prefWidth="180"/>
            <TableColumn fx:id="colPinjam" text="Pinjam" prefWidth="100"/>
            <TableColumn fx:id="colKembali" text="Kembali" prefWidth="100"/>
        </columns>
    </TableView>
</VBox>