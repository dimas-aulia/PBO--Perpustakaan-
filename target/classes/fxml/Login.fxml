<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.shape.Circle?>

<StackPane prefHeight="600" prefWidth="900"
           xmlns="http://javafx.com/javafx/25"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="controller.LoginController">

    <!-- BACKGROUND LAYER dengan efek blur -->
    <StackPane>
        <style>
            -fx-background-color: linear-gradient(135deg,
            #667eea 0%,
            #764ba2 25%,
            #f093fb 50%,
            #4facfe 75%,
            #00f2fe 100%);
        </style>

        <!-- Animated circles untuk efek dinamis -->
        <Circle radius="120" translateX="-250" translateY="-150"
                fill="rgba(255,255,255,0.1)"
                style="-fx-effect: dropshadow(gaussian, rgba(255,255,255,0.3), 40, 0, 0, 0);"/>
        <Circle radius="80" translateX="280" translateY="-180"
                fill="rgba(255,255,255,0.08)"/>
        <Circle radius="150" translateX="200" translateY="180"
                fill="rgba(255,255,255,0.12)"
                style="-fx-effect: dropshadow(gaussian, rgba(255,255,255,0.2), 30, 0, 0, 0);"/>
        <Circle radius="60" translateX="-300" translateY="150"
                fill="rgba(255,255,255,0.1)"/>
    </StackPane>

    <!-- MAIN CARD -->
    <VBox alignment="CENTER"
          spacing="20"
          prefWidth="400"
          style="-fx-background-color: rgba(255, 255, 255, 0.95);
                 -fx-background-radius: 20;
                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 30, 0, 0, 10);">
        <padding>
            <Insets top="40" right="40" bottom="40" left="40"/>
        </padding>

        <!-- ICON HEADER -->
        <VBox alignment="CENTER" spacing="8">
            <!-- Book Icon menggunakan Label dengan Unicode -->
            <Label text="📚" style="-fx-font-size: 48px;"/>

            <!-- TITLE -->
            <Label text="PERPUSTAKAAN">
                <font>
                    <Font name="System Bold" size="28"/>
                </font>
                <style>
                    -fx-text-fill: linear-gradient(to right, #667eea, #764ba2);
                    -fx-font-weight: bold;
                </style>
            </Label>

            <Label text="Masuk ke Akun Anda"
                   style="-fx-text-fill: #7f8c8d; -fx-font-size: 14px;"/>
        </VBox>

        <!-- FORM CONTAINER -->
        <VBox spacing="18" prefWidth="320">

            <!-- USERNAME FIELD -->
            <VBox spacing="6">
                <Label text="Username"
                       style="-fx-text-fill: #2c3e50; -fx-font-weight: bold; -fx-font-size: 13px;"/>
                <TextField fx:id="username"
                           prefHeight="45"
                           promptText="Masukkan username"
                           style="-fx-background-color: #f8f9fa;
                                  -fx-background-radius: 10;
                                  -fx-border-color: #e0e0e0;
                                  -fx-border-radius: 10;
                                  -fx-border-width: 1.5;
                                  -fx-padding: 12;
                                  -fx-font-size: 14px;
                                  -fx-prompt-text-fill: #95a5a6;">
                    <font>
                        <Font size="14"/>
                    </font>
                </TextField>
            </VBox>

            <!-- PASSWORD FIELD + TOGGLE -->
            <VBox spacing="6">
                <Label text="Password"
                       style="-fx-text-fill: #2c3e50; -fx-font-weight: bold; -fx-font-size: 13px;"/>

                <HBox spacing="8" alignment="CENTER_RIGHT">

                    <!-- PASSWORD TERSEMBUNYI -->
                    <PasswordField fx:id="password"
                                   prefHeight="45"
                                   HBox.hgrow="ALWAYS"
                                   promptText="Masukkan password"
                                   style="-fx-background-color: #f8f9fa;
                              -fx-background-radius: 10;
                              -fx-border-color: #e0e0e0;
                              -fx-border-radius: 10;
                              -fx-border-width: 1.5;
                              -fx-padding: 12;
                              -fx-font-size: 14px;
                              -fx-prompt-text-fill: #95a5a6;"/>

                    <!-- PASSWORD TERLIHAT -->
                    <TextField fx:id="passwordText"
                               prefHeight="45"
                               HBox.hgrow="ALWAYS"
                               promptText="Masukkan password"
                               visible="false"
                               managed="false"
                               style="-fx-background-color: #f8f9fa;
                          -fx-background-radius: 10;
                          -fx-border-color: #e0e0e0;
                          -fx-border-radius: 10;
                          -fx-border-width: 1.5;
                          -fx-padding: 12;
                          -fx-font-size: 14px;
                          -fx-prompt-text-fill: #95a5a6;"/>

                    <!-- TOMBOL MATA -->
                    <Button text="👁"
                            onAction="#togglePassword"
                            style="-fx-background-color: transparent;
                       -fx-font-size: 16px;
                       -fx-cursor: hand;"/>
                </HBox>
            </VBox>




            <!-- REMEMBER ME -->
            <HBox alignment="CENTER_LEFT" spacing="8">
                <CheckBox text="Ingat saya"
                          style="-fx-text-fill: #7f8c8d; -fx-font-size: 12px;"/>
            </HBox>

            <!-- LOGIN BUTTON -->
            <Button text="MASUK"
                    prefHeight="48"
                    prefWidth="320"
                    onAction="#handleLogin"
                    style="-fx-background-color: linear-gradient(to right, #667eea, #764ba2);
                           -fx-text-fill: white;
                           -fx-font-weight: bold;
                           -fx-font-size: 15px;
                           -fx-background-radius: 10;
                           -fx-cursor: hand;
                           -fx-effect: dropshadow(gaussian, rgba(102, 126, 234, 0.4), 15, 0, 0, 5);">
                <font>
                    <Font name="System Bold" size="15"/>
                </font>
            </Button>

            <!-- FORGOT PASSWORD -->
            <HBox alignment="CENTER" spacing="5">
                <Label text="Lupa password?"
                       style="-fx-text-fill: #7f8c8d; -fx-font-size: 12px;"/>
                <Hyperlink text="Reset di sini"
                           style="-fx-text-fill: #667eea;
                                  -fx-font-size: 12px;
                                  -fx-underline: true;
                                  -fx-border-width: 0;"/>
            </HBox>
        </VBox>

        <!-- FOOTER -->
        <VBox alignment="CENTER" spacing="8">
            <Separator prefWidth="300" style="-fx-background-color: #ecf0f1;"/>
            <Label text="© 2024 Sistem Perpustakaan Digital"
                   style="-fx-text-fill: #95a5a6; -fx-font-size: 11px;"/>
        </VBox>
    </VBox>
</StackPane>