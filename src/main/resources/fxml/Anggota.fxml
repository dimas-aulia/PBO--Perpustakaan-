<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefWidth="844" prefHeight="400"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.AnggotaController">

    <children>

        <VBox layoutX="20" layoutY="40" spacing="15">
            <Label text="ID ANGGOTA"/>
            <Label text="NAMA"/>
            <Label text="TELEPON"/>
            <Label text="JURUSAN"/>
        </VBox>

        <VBox layoutX="140" layoutY="36" spacing="10">
            <TextField fx:id="idUser"/>
            <TextField fx:id="nama"/>
            <TextField fx:id="telepon"/>
            <TextField fx:id="jurusan"/>
        </VBox>

        <TableView fx:id="tableAnggota" layoutX="330" layoutY="25"
                   prefWidth="500" prefHeight="350">
            <columns>
                <TableColumn fx:id="colIdUser" text="ID"/>
                <TableColumn fx:id="colNama" text="NAMA"/>
                <TableColumn fx:id="colTelepon" text="TELEPON"/>
                <TableColumn fx:id="colJurusan" text="JURUSAN"/>
            </columns>
        </TableView>

        <Button text="SIMPAN" layoutX="40" layoutY="220"
                onAction="#handleSimpan"/>
        <Button text="HAPUS" layoutX="120" layoutY="220"
                onAction="#handleHapus"/>
        <Button text="UBAH" layoutX="200" layoutY="220"
                onAction="#handleUbah"/>

    </children>
</AnchorPane>
