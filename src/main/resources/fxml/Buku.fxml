<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="420.0" prefWidth="964.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.BukuController">

    <children>

        <!-- LABEL -->
        <VBox layoutX="30" layoutY="30" spacing="20.0">
            <children>
                <Label lineSpacing="12.0" text="ID BUKU" />
                <Label lineSpacing="12.0" text="NAMA BUKU" />
                <Label lineSpacing="12.0" text="PENULIS" />
                <Label lineSpacing="12.0" text="TAHUN" />
                <Label lineSpacing="12.0" text="HALAMAN" />
            </children>
        </VBox>

        <!-- INPUT -->
        <VBox layoutX="130" layoutY="30" spacing="10">
            <children>
                <TextField fx:id="id" />
                <TextField fx:id="nama" />
                <TextField fx:id="penulis" />
                <TextField fx:id="tahun" />
                <TextField fx:id="halaman" />
            </children>
        </VBox>

        <!-- BUTTON -->
        <HBox layoutX="30" layoutY="270" spacing="10">
            <children>
                <Button onAction="#handleSimpan" text="SIMPAN" />
                <Button onAction="#handleUbah" text="UBAH" />
                <Button onAction="#handleHapus" text="HAPUS" />
            </children>
        </HBox>

        <!-- TABLE -->
        <TableView fx:id="tableBuku" layoutX="350" layoutY="25" prefHeight="360" prefWidth="577.0">

            <columns>
                <TableColumn fx:id="colId" prefWidth="80" text="ID" />
                <TableColumn fx:id="colNama" prefWidth="120" text="NAMA" />
                <TableColumn fx:id="colPenulis" prefWidth="120" text="PENULIS" />
                <TableColumn fx:id="colTahun" prefWidth="80" text="TAHUN" />
                <TableColumn fx:id="colHalaman" prefWidth="80" text="HALAMAN" />
                <TableColumn fx:id="colStatus" prefWidth="100" text="STATUS" />
            </columns>

        </TableView>

    </children>
</AnchorPane>
