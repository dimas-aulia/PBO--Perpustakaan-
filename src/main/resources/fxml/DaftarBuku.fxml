<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.DaftarBukuController"
            style="-fx-background-color: #F4F6F8;">

    <top>
        <HBox spacing="15" alignment="CENTER_LEFT" style="-fx-background-color: #00796B; -fx-padding: 15;">
            <children>
                <Button text="← Kembali" onAction="#handleBack"
                        style="-fx-background-color: #004D40; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"/>

                <Region HBox.hgrow="ALWAYS" />

                <HBox alignment="CENTER_RIGHT" spacing="5">
                    <TextField fx:id="txtSearch" promptText="Cari judul buku..."
                               style="-fx-pref-width: 250; -fx-background-radius: 20 0 0 20; -fx-padding: 8 15;"/>

                    <Button text="🔍 Cari" onAction="#handleSearch"
                            style="-fx-background-color: #FFB300; -fx-text-fill: #2C3E50; -fx-font-weight: bold;
                               -fx-background-radius: 0 20 20 0; -fx-padding: 8 15; -fx-cursor: hand;"/>
                </HBox>

                <Region HBox.hgrow="ALWAYS" />

                <Label text="📚 PERPUSTAKAAN" style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;"/>
            </children>
        </HBox>
    </top>

    <center>
        <VBox spacing="20" alignment="TOP_CENTER">
            <padding>
                <Insets top="30" right="20" bottom="20" left="20"/>
            </padding>

            <Label text="DAFTAR KOLEKSI BUKU"
                   style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2C3E50;"/>

            <ScrollPane fitToHeight="true"
                        style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;"
                        vbarPolicy="NEVER"
                        hbarPolicy="AS_NEEDED">
                <content>
                    <HBox fx:id="bukuContainer"
                          spacing="30"
                          alignment="CENTER_LEFT"
                          style="-fx-padding: 20 10;" />
                </content>
            </ScrollPane>
        </VBox>
    </center>
</BorderPane>